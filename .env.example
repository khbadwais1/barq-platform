# Copy to .env and fill in. Never commit .env
DATABASE_URL="postgresql://barq:barq_dev_password@localhost:5433/barq?schema=public"
TEST_DATABASE_URL="postgresql://barq:barq_dev_password@localhost:5433/barq_test?schema=public"
# Session lifetime in minutes of inactivity
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
# Set to "true" only behind HTTPS
COOKIE_SECURE=false
# Directory where uploaded attachments are stored
UPLOAD_DIR=./storage/uploads
