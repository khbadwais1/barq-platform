// سقالات البرق — مخطط قاعدة البيانات
// قاعدة: الأرصدة المالية والمخزنية تتغير فقط عبر خدمات src/server/services داخل معاملات.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── المستخدمون والصلاحيات ─────────────────────────

enum Role {
  OWNER
  FINANCE
  SELLER
  WAREHOUSE
}

model Branch {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  address    String?
  createdAt  DateTime    @default(now())
  warehouses Warehouse[]
  accounts   Account[]
  users      User[]
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  balances      StockBalance[]
  movements     InventoryMovement[]
  sales         Sale[]
  rentals       Rental[]
  deliveryNotes DeliveryNote[]
  returnNotes   ReturnNote[]
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  passwordHash       String
  role               Role
  /// صلاحيات إضافية مستقلة عن الدور، مثل catalog.manage أو sales.viewAll
  permissions        String[]  @default([])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  /// حد الخصم المسموح للبائع كنسبة مئوية من المستند (null = إعداد النظام)
  maxDiscountPct     Decimal?  @db.Decimal(5, 2)
  commissionPct      Decimal?  @db.Decimal(5, 2)
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions        Session[]
  loginAttempts   LoginAttempt[]
  representative  Representative? @relation("RepUser")
  repAssignments  RepresentativeAssignment[]
  salesAsSeller   Sale[]          @relation("SaleSeller")
  rentalsAsSeller Rental[]        @relation("RentalSeller")
  customersCreated Customer[]     @relation("CustomerCreatedBy")
  paymentsRecorded Payment[]      @relation("PaymentRecordedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]
  followUps       FollowUp[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// ───────────────────────── المناديب والمتابعة ─────────────────────────

/// المندوب: موظف لدى البرق يجلب العملاء. جهة مستقلة، وقد يرتبط بحساب مستخدم.
model Representative {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  mobile    String?
  userId    String?  @unique
  user      User?    @relation("RepUser", fields: [userId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments RepresentativeAssignment[]
  customers   Customer[]
  sales       Sale[]
  rentals     Rental[]
  payments    Payment[]
  followUps   FollowUp[]
}

/// إسناد متابعة المندوب لموظف أو أكثر. لا يُحذف عند النقل بل يُغلق endedAt.
model RepresentativeAssignment {
  id               String         @id @default(cuid())
  representativeId String
  representative   Representative @relation(fields: [representativeId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  startedAt        DateTime       @default(now())
  endedAt          DateTime?

  @@index([userId])
}

model FollowUp {
  id               String          @id @default(cuid())
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id])
  representativeId String?
  representative   Representative? @relation(fields: [representativeId], references: [id])
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  channel          String          @default("CALL")
  outcome          String
  notes            String?
  nextActionAt     DateTime?
  createdAt        DateTime        @default(now())

  @@index([customerId])
  @@index([userId, nextActionAt])
}

// ───────────────────────── العملاء والمشاريع ─────────────────────────

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

model Customer {
  id               String          @id @default(cuid())
  code             String          @unique
  type             CustomerType
  name             String
  /// اسم العلامة التجارية (للمنشآت)
  tradeName        String?
  /// المعرّفات تُحفظ نصًا بأرقام لاتينية مع الأصفار البادئة
  nationalId       String?
  iqamaNumber      String?
  crNumber         String?
  vatNumber        String?
  mobile           String
  /// الجوال بصيغة موحدة 05XXXXXXXX للبحث
  mobileNormalized String
  phone2           String?
  city             String?
  address          String?
  /// رقم الملف في الكرت الورقي القديم
  legacyFileNo     String?
  guarantorName    String?
  guarantorMobile  String?
  guarantorIdNo    String?
  representativeId String?
  representative   Representative? @relation(fields: [representativeId], references: [id])
  createdById      String
  createdBy        User            @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  creditLimit      Decimal?        @db.Decimal(14, 2)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  projects        Project[]
  ratings         CustomerRating[]
  blacklistEvents BlacklistEvent[]
  sales           Sale[]
  rentals         Rental[]
  invoices        Invoice[]
  payments        Payment[]
  deliveryNotes   DeliveryNote[]
  returnNotes     ReturnNote[]
  promissoryNotes PromissoryNote[]
  documents       Document[]
  followUps       FollowUp[]

  @@index([mobileNormalized])
  @@index([nationalId])
  @@index([iqamaNumber])
  @@index([crNumber])
  @@index([createdById])
}

model CustomerRating {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  rating     Int
  reason     String
  ratedById  String
  ratedAt    DateTime @default(now())

  @@index([customerId, ratedAt])
}

enum BlacklistAction {
  BLACKLIST
  UNBLACKLIST
}

enum BlacklistScope {
  CREDIT_ONLY
  ALL_NEW_OPERATIONS
}

model BlacklistEvent {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  action      BlacklistAction
  scope       BlacklistScope  @default(ALL_NEW_OPERATIONS)
  reason      String
  decidedById String
  decidedAt   DateTime        @default(now())

  @@index([customerId, decidedAt])
}

model Project {
  id         String   @id @default(cuid())
  code       String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String
  location   String?
  details    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  sales           Sale[]
  rentals         Rental[]
  invoices        Invoice[]
  payments        Payment[]
  deliveryNotes   DeliveryNote[]
  returnNotes     ReturnNote[]
  promissoryNotes PromissoryNote[]
  expenses        Expense[]
  documents       Document[]
  followUps       FollowUp[]

  @@index([customerId])
}

// ───────────────────────── الكتالوج والمخزون ─────────────────────────

enum PricingUnit {
  PIECE
  METER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

/// متغير صنف: عائلة (قائم، مرابيع…) × مقاس. المخزون يُتابع بالقطع (العدد).
model Product {
  id             String        @id @default(cuid())
  sku            String        @unique
  name           String
  family         String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  /// طول القطعة بالمتر (الكمية = العدد × الطول)
  lengthM        Decimal?      @db.Decimal(8, 2)
  unit           String        @default("قطعة")
  pricingUnit    PricingUnit   @default(PIECE)
  salePrice      Decimal       @db.Decimal(14, 2)
  costPrice      Decimal       @db.Decimal(14, 2)
  rentDaily      Decimal       @db.Decimal(14, 2)
  rentWeekly     Decimal       @db.Decimal(14, 2)
  rentMonthly    Decimal       @db.Decimal(14, 2)
  /// قيمة التعويض عند الفقد
  replacementFee Decimal       @default(0) @db.Decimal(14, 2)
  minStock       Int           @default(0)
  allowBackorder Boolean       @default(false)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  balances    StockBalance[]
  movements   InventoryMovement[]
  saleItems   SaleItem[]
  rentalItems RentalItem[]
}

/// رصيد صنف في مستودع، موزع على الحالات. يطابق دفتر InventoryMovement دائمًا.
model StockBalance {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  available   Int       @default(0)
  reserved    Int       @default(0)
  rented      Int       @default(0)
  damaged     Int       @default(0)
  lost        Int       @default(0)
  maintenance Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

enum StockState {
  AVAILABLE
  RESERVED
  RENTED
  DAMAGED
  LOST
  MAINTENANCE
}

enum MovementType {
  OPENING
  PURCHASE_IN
  SALE_OUT
  RESERVE
  UNRESERVE
  RENTAL_OUT
  RENTAL_RETURN
  STATE_CHANGE
  ADJUSTMENT
}

/// دفتر المخزون. fromState=null يعني من خارج المؤسسة، toState=null يعني إلى خارجها (مباع).
model InventoryMovement {
  id             String        @id @default(cuid())
  type           MovementType
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  quantity       Int
  fromState      StockState?
  toState        StockState?
  customerId     String?
  projectId      String?
  saleId         String?
  rentalId       String?
  rentalItemId   String?
  deliveryNoteId String?
  returnNoteId   String?
  reason         String?
  createdById    String
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([productId, warehouseId, occurredAt])
  @@index([projectId])
  @@index([rentalItemId])
}

// ───────────────────────── البيع ─────────────────────────

enum SaleStatus {
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
}

enum PaymentTerm {
  CASH
  PARTIAL
  CREDIT
}

model Sale {
  id               String          @id @default(cuid())
  number           String          @unique
  sellerId         String
  seller           User            @relation("SaleSeller", fields: [sellerId], references: [id])
  representativeId String?
  representative   Representative? @relation(fields: [representativeId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id])
  warehouseId      String
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id])
  status           SaleStatus
  paymentTerm      PaymentTerm
  dueDate          DateTime?
  /// مجموع الكمية × السعر قبل أي خصم
  grossAmount      Decimal         @db.Decimal(14, 2)
  itemsDiscount    Decimal         @db.Decimal(14, 2)
  docDiscount      Decimal         @db.Decimal(14, 2)
  taxableAmount    Decimal         @db.Decimal(14, 2)
  vatRate          Decimal         @db.Decimal(5, 2)
  vatAmount        Decimal         @db.Decimal(14, 2)
  total            Decimal         @db.Decimal(14, 2)
  /// تكلفة البضاعة المباعة وقت البيع (لتعريف الربح)
  costAmount       Decimal         @db.Decimal(14, 2)
  location         String?
  notes            String?
  idempotencyKey   String          @unique
  createdAt        DateTime        @default(now())
  confirmedAt      DateTime?
  cancelledAt      DateTime?

  items         SaleItem[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]

  @@index([sellerId, createdAt])
  @@index([customerId])
  @@index([projectId])
}

model SaleItem {
  id          String      @id @default(cuid())
  saleId      String
  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  sku         String
  name        String
  lengthM     Decimal?    @db.Decimal(8, 2)
  /// العدد (قطع)
  count       Int
  /// الكمية بالمتر = العدد × الطول
  meters      Decimal?    @db.Decimal(12, 2)
  pricingUnit PricingUnit
  unitPrice   Decimal     @db.Decimal(14, 2)
  unitCost    Decimal     @db.Decimal(14, 2)
  lineGross   Decimal     @db.Decimal(14, 2)
  discount    Decimal     @db.Decimal(14, 2)
  lineNet     Decimal     @db.Decimal(14, 2)
}

// ───────────────────────── الإيجار ─────────────────────────

enum RentalStatus {
  PENDING_APPROVAL
  RESERVED
  ACTIVE
  PARTIALLY_RETURNED
  RETURNED
  CLOSED
  CANCELLED
}

enum PricingBasis {
  DAILY
  WEEKLY
  MONTHLY
}

enum RentalBillingMode {
  /// مدة متفق عليها تُفوتر مقدمًا، وما زاد عنها يُفوتر لاحقًا
  FIXED
  /// مفتوح: يُفوتر دوريًا حسب القطع الموجودة فعليًا بالموقع
  OPEN
}

model Rental {
  id               String            @id @default(cuid())
  number           String            @unique
  sellerId         String
  seller           User              @relation("RentalSeller", fields: [sellerId], references: [id])
  representativeId String?
  representative   Representative?   @relation(fields: [representativeId], references: [id])
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  status           RentalStatus
  billingMode      RentalBillingMode
  pricingBasis     PricingBasis
  /// عدد الفترات المتفق عليها (أيام/أسابيع/أشهر حسب الأساس)
  plannedPeriods   Int
  startDate        DateTime
  expectedEndDate  DateTime
  dueDays          Int               @default(0)
  vatRate          Decimal           @db.Decimal(5, 2)
  discount         Decimal           @default(0) @db.Decimal(14, 2)
  /// القيمة التقديرية وقت العقد (أساس التسعير × الكمية × الفترات)
  estimatedTaxable Decimal           @db.Decimal(14, 2)
  estimatedVat     Decimal           @db.Decimal(14, 2)
  estimatedTotal   Decimal           @db.Decimal(14, 2)
  depositRequired  Decimal           @default(0) @db.Decimal(14, 2)
  location         String?
  notes            String?
  idempotencyKey   String            @unique
  createdAt        DateTime          @default(now())
  closedAt         DateTime?
  cancelledAt      DateTime?

  items         RentalItem[]
  invoices      Invoice[]
  deliveryNotes DeliveryNote[]
  returnNotes   ReturnNote[]
  deposits      RentalDeposit[]

  @@index([sellerId, createdAt])
  @@index([customerId])
  @@index([projectId])
}

model RentalItem {
  id           String       @id @default(cuid())
  rentalId     String
  rental       Rental       @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  sku          String
  name         String
  lengthM      Decimal?     @db.Decimal(8, 2)
  /// العدد المطلوب (قطع)
  quantity     Int
  /// السعر لكل قطعة لكل فترة من أساس التسعير
  rate         Decimal      @db.Decimal(14, 2)
  /// عدادات تُحدّث داخل المعاملة نفسها التي تنشئ الحركة المخزنية
  deliveredQty Int          @default(0)
  returnedQty  Int          @default(0)
  /// آخر يوم (حصري) تمت فوترته لهذا البند
  billedThrough DateTime?

  returnItems ReturnNoteItem[]
}

model RentalDeposit {
  id             String      @id @default(cuid())
  rentalId       String
  rental         Rental      @relation(fields: [rentalId], references: [id])
  kind           DepositKind
  amount         Decimal     @db.Decimal(14, 2)
  accountId      String
  account        Account     @relation(fields: [accountId], references: [id])
  method         PaymentMethod
  reference      String?
  notes          String?
  recordedById   String
  idempotencyKey String      @unique
  occurredAt     DateTime    @default(now())

  transaction FinancialTransaction?
}

enum DepositKind {
  RECEIVED
  REFUNDED
  FORFEITED
}

// ───────────────────────── سندات الاستلام والدخول ─────────────────────────

enum DeliveryKind {
  SALE
  RENTAL
}

/// سند استلام مواد (تسليم للعميل). مرتبط بالحركة الأصلية فلا تُخصم الكمية مرتين.
model DeliveryNote {
  id               String       @id @default(cuid())
  number           String       @unique
  kind             DeliveryKind
  saleId           String?
  sale             Sale?        @relation(fields: [saleId], references: [id])
  rentalId         String?
  rental           Rental?      @relation(fields: [rentalId], references: [id])
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id])
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id])
  warehouseId      String
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id])
  representativeName String?
  driverName       String?
  receiverName     String?
  notes            String?
  createdById      String
  idempotencyKey   String       @unique
  templateVersion  Int          @default(1)
  occurredAt       DateTime     @default(now())

  items DeliveryNoteItem[]

  @@index([customerId])
  @@index([projectId])
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  productId      String
  rentalItemId   String?
  sku            String
  name           String
  count          Int
  meters         Decimal?     @db.Decimal(12, 2)
  unitPrice      Decimal?     @db.Decimal(14, 2)
}

enum ReturnCondition {
  GOOD
  MAINTENANCE
  DAMAGED
  LOST
}

/// كشف دخول (مرتجع إيجار) — يسجله مسؤول العدد
model ReturnNote {
  id             String     @id @default(cuid())
  number         String     @unique
  rentalId       String
  rental         Rental     @relation(fields: [rentalId], references: [id])
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id])
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id])
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id])
  driverName     String?
  counterName    String?
  gateOfficer    String?
  /// مبلغ الصيانة/التعويض قبل الضريبة (يُفوتر كرسوم)
  maintenanceFee Decimal    @default(0) @db.Decimal(14, 2)
  notes          String?
  createdById    String
  idempotencyKey String     @unique
  occurredAt     DateTime   @default(now())

  items ReturnNoteItem[]

  @@index([customerId])
  @@index([projectId])
}

model ReturnNoteItem {
  id           String          @id @default(cuid())
  returnNoteId String
  returnNote   ReturnNote      @relation(fields: [returnNoteId], references: [id], onDelete: Cascade)
  rentalItemId String
  rentalItem   RentalItem      @relation(fields: [rentalItemId], references: [id])
  productId    String
  sku          String
  name         String
  quantity     Int
  condition    ReturnCondition
}

// ───────────────────────── الفواتير والتحصيل ─────────────────────────

enum InvoiceKind {
  SALE
  RENTAL
  FEES
}

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  kind         InvoiceKind
  status       InvoiceStatus @default(ISSUED)
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id])
  rentalId     String?
  rental       Rental?       @relation(fields: [rentalId], references: [id])
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  sellerId     String
  issueDate    DateTime      @default(now())
  dueDate      DateTime
  periodFrom   DateTime?
  periodTo     DateTime?
  grossAmount  Decimal       @db.Decimal(14, 2)
  discount     Decimal       @db.Decimal(14, 2)
  taxable      Decimal       @db.Decimal(14, 2)
  vatRate      Decimal       @db.Decimal(5, 2)
  vatAmount    Decimal       @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  /// يُحدّث ذريًا مع كل تخصيص دفعة ويطابق مجموع PaymentAllocation
  paidAmount   Decimal       @default(0) @db.Decimal(14, 2)
  /// معرّف ZATCA
  uuid         String        @unique @default(uuid())
  createdById  String
  notes        String?
  createdAt    DateTime      @default(now())

  items       InvoiceItem[]
  allocations PaymentAllocation[]

  @@index([customerId])
  @@index([projectId])
  @@index([issueDate])
  @@index([sellerId, issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  discount    Decimal @db.Decimal(14, 2)
  lineNet     Decimal @db.Decimal(14, 2)
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHEQUE
}

enum PaymentStatus {
  POSTED
  VOID
}

/// سند قبض
model Payment {
  id                 String          @id @default(cuid())
  number             String          @unique
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id])
  projectId          String?
  project            Project?        @relation(fields: [projectId], references: [id])
  amount             Decimal         @db.Decimal(14, 2)
  method             PaymentMethod
  accountId          String
  account            Account         @relation(fields: [accountId], references: [id])
  reference          String?
  chequeNumber       String?
  chequeBank         String?
  chequeDueDate      DateTime?
  representativeId   String?
  representative     Representative? @relation(fields: [representativeId], references: [id])
  /// اسم المندوب وقت الإصدار (يبقى ثابتًا حتى لو تغيّر لاحقًا)
  representativeName String?
  recordedById       String
  recordedBy         User            @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  status             PaymentStatus   @default(POSTED)
  notes              String?
  idempotencyKey     String          @unique
  receivedAt         DateTime        @default(now())
  createdAt          DateTime        @default(now())

  allocations PaymentAllocation[]
  transaction FinancialTransaction?

  @@index([customerId])
  @@index([receivedAt])
  @@index([representativeId])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(14, 2)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ───────────────────────── الحسابات والمصروفات ─────────────────────────

enum AccountType {
  CASH
  BANK
}

model Account {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  type           AccountType
  bankName       String?
  iban           String?
  branchId       String
  branch         Branch      @relation(fields: [branchId], references: [id])
  /// الرصيد الافتتاحي يُحتسب مرة واحدة هنا وليس كحركة
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  openingDate    DateTime    @default(now())
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  transactions FinancialTransaction[]
  payments     Payment[]
  expenses     Expense[]
  deposits     RentalDeposit[]
}

enum TxDirection {
  IN
  OUT
}

enum TxSource {
  PAYMENT
  EXPENSE
  DEPOSIT
  ADJUSTMENT
}

/// قيد على حساب. رصيد الحساب = الافتتاحي + Σ الداخل − Σ الخارج
model FinancialTransaction {
  id          String         @id @default(cuid())
  accountId   String
  account     Account        @relation(fields: [accountId], references: [id])
  direction   TxDirection
  amount      Decimal        @db.Decimal(14, 2)
  source      TxSource
  paymentId   String?        @unique
  payment     Payment?       @relation(fields: [paymentId], references: [id])
  expenseId   String?        @unique
  expense     Expense?       @relation(fields: [expenseId], references: [id])
  depositId   String?        @unique
  deposit     RentalDeposit? @relation(fields: [depositId], references: [id])
  description String
  createdById String
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([accountId, occurredAt])
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id             String        @id @default(cuid())
  number         String        @unique
  category       String
  amount         Decimal       @db.Decimal(14, 2)
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id])
  description    String
  status         ExpenseStatus
  requestedById  String
  reviewedById   String?
  reviewedAt     DateTime?
  reviewReason   String?
  attachmentId   String?
  idempotencyKey String        @unique
  spentAt        DateTime      @default(now())
  createdAt      DateTime      @default(now())

  transaction FinancialTransaction?

  @@index([status])
  @@index([spentAt])
}

// ───────────────────────── الموافقات والمستندات والتنبيهات ─────────────────────────

enum ApprovalType {
  EXPENSE
  SALE_DISCOUNT
  RENTAL_DISCOUNT
  CANCEL_SALE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id            String         @id @default(cuid())
  type          ApprovalType
  entityType    String
  entityId      String
  status        ApprovalStatus @default(PENDING)
  summary       String
  amount        Decimal?       @db.Decimal(14, 2)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  reason        String?
  createdAt     DateTime       @default(now())

  @@index([status])
  @@index([entityType, entityId])
}

enum PromissoryStatus {
  ACTIVE
  SETTLED
  RETURNED
  CANCELLED
}

/// سند لأمر: فهرسة ومتابعة فقط — لا أثر له على الصندوق ولا يُحسب قبضًا
model PromissoryNote {
  id          String           @id @default(cuid())
  number      String
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  amount      Decimal          @db.Decimal(14, 2)
  issueDate   DateTime
  dueDate     DateTime?
  status      PromissoryStatus @default(ACTIVE)
  notes       String?
  documentId  String?
  createdById String
  createdAt   DateTime         @default(now())

  @@index([customerId])
}

model Document {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id])
  title        String
  fileName     String
  mimeType     String
  size         Int
  storageKey   String    @unique
  uploadedById String
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  link      String?
  /// يمنع تكرار نفس التنبيه
  dedupeKey String    @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  role       String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// عدّاد ترقيم متسلسل للمستندات (لا فجوات خارج المعاملات الفاشلة)
model DocumentSequence {
  key   String @id
  value Int    @default(0)
}
